# Configuração do Servidor
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/financeiro?authSource=admin

# JWT
# INSECURE - Gere um segredo forte para produção usando: openssl rand -base64 32
# NUNCA use este valor em produção!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Opcional: Prefixo global da API
API_PREFIX=api
